diff --git a/CPP/7zip/Compress/Lzma2Encoder.cpp b/CPP/7zip/Compress/Lzma2Encoder.cpp
--- a/CPP/7zip/Compress/Lzma2Encoder.cpp
+++ b/CPP/7zip/Compress/Lzma2Encoder.cpp
@@ -217,3 +217,8 @@ HRESULT CFastEncoder::FastLzma2::SetCoderProperties(const PROPID *propIDs, const
   dictSize = Z7_min(dictSize, reduceSize);
   dictSize = Z7_max(dictSize, (size_t)FL2_DICTSIZE_MIN);
+  // The wrapper bumps reduceSize by one to avoid an extra buffer shift at EOF.
+  // For a stream of exactly FL2_DICTSIZE_MAX bytes that makes dictSize one
+  // byte too large for the 32-bit build and FL2 rejects it (E_INVALIDARG).
+  // Clamp to the library maximum; on 64-bit builds this is 1 GiB.
+  dictSize = Z7_min(dictSize, (size_t)FL2_DICTSIZE_MAX);
   CHECK_P(FL2_CCtx_setParameter(fcs, FL2_p_dictionarySize, dictSize));
